default partial alphanumeric_keys
xkb_symbols "basic" {
    // Heredamos todo del español normal
    include "es(basic)"
    name[Group1]="Spanish (Instant Circumflex)";

    // AD11 es la tecla a la derecha de la P.
    // Originalmente es: [ dead_grave, dead_circumflex, ... ]
    // La cambiamos a:   [ dead_grave, asciicircum, ... ]

    // dead_grave = el acento grave (`) espera vocal (para à)
    // asciicircum = el símbolo ^ sale AL INSTANTE

    key <AD11> { [ dead_grave, asciicircum, bracketleft, bracketright ] };
};
