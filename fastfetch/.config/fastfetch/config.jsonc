{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "/home/pbl/.config/fastfetch/arch.txt",
        "width": 16,
        "padding": {
            "top": 2,
            "right": 0,
            "left": 3
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "yellow",
            "title": "yellow"
        }
    },
    "modules": [
        // --- CABECERA ---
        {
            "type": "title",
            "format": "   コンピューター : {user-name} @ {host-name}",
            "outputColor": "blue"
        },
        
        // --- CAJA SUPERIOR (Borde Arriba) ---
        {
            "type": "custom",
            "format": "┌────────────────────────────────────────┐",
            "outputColor": "white"
        },
        {
            "type": "os",
            "key": "    ", // Ajusta espacios para alinear
            "keyColor": "default"
        },
        {
            "type": "packages",
            "key": "    ",
            "keyColor": "default"
        },
        {
            "type": "display",
            "key": "    ",
            "keyColor": "default"
        },
        {
            "type": "terminal",
            "key": "    ",
            "keyColor": "default"
        },
        {
            "type": "wm",
            "key": "    ",
            "keyColor": "default"
        },
        {
          "type": "terminalfont",
          "key": "    ",
          "keyColor": "default"
        },

        {
            "type": "cpu",
            "key": "    ",
            "keyColor": "default"
        },
        {
            "type": "gpu",
            "key": "    ",
            "keyColor": "default"
        },
        {
            "type": "memory",
            "key": "    ",
            "keyColor": "default"
        },
        // --- CAJA INFERIOR (Borde Abajo) ---
        {
            "type": "custom",
            "format": "└────────────────────────────────────────┘",
            "outputColor": "white"
        },
        // --- PUNTOS DE COLORES (Bubbles) ---
        {
            "type": "colors",
            "symbol": "square",
            "paddingLeft": 10
        }
    ]
}
