source = $HOME/.config/hypr/config/variables.conf
# Ignore maximize requests from apps
windowrule = suppress_event maximize, match:class .*

# Arreglo para problemas de arrastre en XWayland (Fix XWayland drags)
# Al tener muchas condiciones, usamos el formato de BLOQUE para que no falle.
windowrule {
    name = fix-xwayland-ghosts
    match:class = ^$
    match:title = ^$
    match:xwayland = true
    match:float = true
    match:fullscreen = false
    match:pin = false
    
    no_focus = on
}

# Desactivar blur en ventanas vacías (evita glitches visuales)
windowrule = no_blur on, match:class ^$, match:title ^$source = $HOME/.config/hypr/config/variables.conf

# LAYER RULES
layerrule = blur on, match:namespace wofi
layerrule = xray on, match:namespace wofi
layerrule = dim_around on, match:namespace wofi
layerrule = ignore_alpha 0.9, match:namespace wofi

# --- HYPRSWITCH (Cambiador de ventanas) ---
# 'noanim' ahora es 'no_anim'
layerrule = no_anim on, match:namespace hyprswitch
layerrule = no_anim on, match:namespace mpv


# --- WAYBAR (Barra Superior) ---
# He descomentado esto y arreglado la sintaxis (blur_popups lleva guion bajo)
layerrule = blur on, match:namespace waybar
layerrule = xray on, match:namespace waybar
layerrule = ignore_alpha 0.5, match:namespace waybar
layerrule = blur_popups on, match:namespace waybar
# Si quieres efecto borroso detrás (opcional)
